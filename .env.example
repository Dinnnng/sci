# LLM API key (compatible with OpenAI format)
# For Qwen: https://dashscope.console.aliyun.com/
OPENAI_API_KEY=sk-...

# LLM base URL (for Qwen/other OpenAI-compatible providers)
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM model name
LLM_MODEL=qwen3.5-flash

# Optional: contact email for OpenAlex polite pool (recommended)
OPENALEX_EMAIL=your@email.com
